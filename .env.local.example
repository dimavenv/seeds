# Образец. Скопируйте в файл .env.local и подставьте свои ключи Supabase.
# ВАЖНО: .env.local НЕ коммитить в git (он содержит секреты и уже в .gitignore).

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Только сервер — НЕ публиковать на клиенте и НЕ коммитить
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# DaData — подсказки адреса и автоподстановка индекса в оформлении заказа.
# Это API-ключ сервиса подсказок (НЕ секретный ключ). Он попадает в браузерный
# бандл — для подсказок DaData это нормально. Без него поля адреса работают
# вручную. Ключ: dadata.ru → Профиль → API → «Ключ для сервиса подсказок».
NEXT_PUBLIC_DADATA_TOKEN=your-dadata-api-key
