# Образец переменных окружения.
# На сервере: скопируйте в .env.production (создать ДО npm run build).
# Локально для разработки: скопируйте в .env.local.
# ВАЖНО: сами файлы .env* НЕ коммитить в git (они в .gitignore).

# --- SEO: адрес сайта, верификация в панелях, счётчики ---
# Базовый адрес — от него строятся canonical, sitemap.xml, robots.txt, OG-теги
# и микроразметка. На стенде укажите адрес стенда, иначе поисковик получит
# ссылки на боевой домен. Без завершающего слэша.
NEXT_PUBLIC_SITE_URL=https://tomatsemena.ru
# Код подтверждения прав в Яндекс.Вебмастере: webmaster.yandex.ru → добавить
# сайт → «Мета-тег» → скопировать ЗНАЧЕНИЕ атрибута content (без самого тега).
YANDEX_VERIFICATION=
# То же для Google Search Console: search.google.com/search-console → добавить
# ресурс «Ресурс с префиксом в URL» → «Тег HTML» → значение content.
GOOGLE_SITE_VERIFICATION=
# Номер счётчика Яндекс.Метрики (metrika.yandex.ru → счётчик → номер).
# 8–9 цифр: у новых счётчиков номер длиннее, вписывайте как есть.
# Пока пусто — скрипт Метрики в HTML не попадает вообще.
# Вебвизор включается в коде (components/analytics.tsx) и в настройках счётчика.
# Пошагово (счётчик, цели, электронная коммерция) — SETUP-ANALYTICS-RU.md.
NEXT_PUBLIC_YANDEX_METRIKA_ID=
# OAuth-токен Яндекса с правом metrika:read — им админка ЧИТАЕТ посещаемость
# (страница /admin/analytics и плитка «Посетители» на дашборде). СЕКРЕТ: только
# сервер, в браузер не попадает. Как получить — SETUP-ANALYTICS-RU.md, часть 2.
# Пусто — админка работает, но вместо посещаемости показывает инструкцию.
YANDEX_METRIKA_TOKEN=
# Необязательно: номер счётчика для чтения статистики, если он ОТЛИЧАЕТСЯ от
# того, что стоит на сайте. Пусто — берётся NEXT_PUBLIC_YANDEX_METRIKA_ID.
YANDEX_METRIKA_COUNTER_ID=
# Необязательно: Google Analytics 4, идентификатор потока вида G-XXXXXXXXXX.
NEXT_PUBLIC_GA_ID=

# --- PocketBase (база данных) ---
# Адрес, доступный из БРАУЗЕРА покупателя (фото товаров, вход, корзина).
# До домена — http://IP_СЕРВЕРА:8090; после — https://api.tomatsemena.ru
NEXT_PUBLIC_PB_URL=http://ВАШ_IP:8090
# Адрес для серверных запросов сайта (на VPS — localhost, быстрее)
PB_INTERNAL_URL=http://127.0.0.1:8090
# Суперпользователь PocketBase (создаётся на шаге 3 SETUP-DB-RU.md).
# Используется сервером для оформления заказов — НЕ публиковать.
PB_ADMIN_EMAIL=service@tomatsemena.ru
PB_ADMIN_PASSWORD=пароль-суперпользователя

# Шифрование персональных данных (телефон, email, адрес) в БД.
# Только сервер. Сгенерировать: openssl rand -base64 32
# Без ключа данные пишутся в открытом виде; с ключом — шифруются (AES-256-GCM).
# ВАЖНО: не теряйте ключ — иначе зашифрованные записи не прочитать.
DATA_ENCRYPTION_KEY=

# DaData — подсказки адреса и автоподстановка индекса в оформлении заказа.
# Токен теперь СЕРВЕРНЫЙ (в браузер не попадает): запросы идут через прокси
# /api/dadata. Ключ: dadata.ru → Профиль → API.
DADATA_TOKEN=
# Публичный НЕсекретный флаг: включает виджет подсказок в браузере (значение
# любое непустое, например 1). Без него поля адреса заполняются вручную.
NEXT_PUBLIC_DADATA_ENABLED=1
# Устарело: прежний публичный токен. Если он ещё задан — прокси его подхватит,
# но ключ окажется в бандле. Перенесите значение в DADATA_TOKEN и уберите это.
NEXT_PUBLIC_DADATA_TOKEN=

# --- Пункты выдачи Ozon ---
# Пункт выдачи Ozon покупатель пишет вручную при оформлении заказа, все точки —
# по ссылке на карту пунктов выдачи Ozon (ozon.ru/geo). Отдельные ключи для
# карты/справочника ПВЗ не нужны. Доставка Ozon в Крым, Калининград и на
# Камчатку недоступна (ограничение зашито в lib/delivery.ts).

# --- Антибот-капча (Yandex SmartCaptcha, российский сервис) ---
# Пока ключи пустые — капча ВЫКЛЮЧЕНА, формы работают как есть.
# Создать: console.yandex.cloud → SmartCaptcha → создать капчу (бесплатно).
# Клиентский ключ (в браузер) и серверный ключ (только сервер).
NEXT_PUBLIC_SMARTCAPTCHA_SITE_KEY=
SMARTCAPTCHA_SERVER_KEY=

# --- Почта (SMTP): код подтверждения при регистрации + письма о статусах заказов ---
# Инструкция — SETUP-MAIL-RU.md. Пока пусто — письма ВЫКЛЮЧЕНЫ:
# регистрация работает без кода, заказы оформляются без уведомлений.
# SMTP_PASSWORD — «пароль приложения» ящика (НЕ обычный пароль от почты).
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=info@tomatsemena.ru
SMTP_PASSWORD=
MAIL_FROM="Томат Семена <info@tomatsemena.ru>"
# Куда слать УВЕДОМЛЕНИЯ ПРОДАВЦУ (новый заказ, отзыв, вопрос в поддержку).
# Две переменные, обе можно списком через запятую — адреса складываются:
#   ADMIN_NOTIFY_EMAIL       — служебный ящик магазина;
#   ADMIN_NOTIFY_EMAIL_EXTRA — вторая, обычная почта (Яндекс, Gmail, Mail.ru).
# Пароли этих ящиков сайту НЕ нужны — он на них только отправляет.
# Пока обе пустые — уведомления продавцу выключены.
ADMIN_NOTIFY_EMAIL=service@tomatsemena.ru
ADMIN_NOTIFY_EMAIL_EXTRA=

# --- Промокод УРОЖАЙ (запасной, из окружения) ---
# ВАЖНО: промокоды теперь заводятся в АДМИНКЕ — /admin/promos: срок действия,
# процент или сумма, минимальная сумма заказа, лимит применений, условия.
# Переменные ниже — наследие: они действуют, только пока в базе нет НИ ОДНОГО
# кода (чтобы после обновления магазин не остался без работающей скидки).
# Создали первый код в админке — эти переменные больше не учитываются.
#
# Код действует только для покупателей, вошедших в аккаунт, и ровно ОДИН РАЗ
# на аккаунт (учёт — коллекция promo_uses в PocketBase, npm run db:schema).
# Скидка считается от суммы товаров, доставка не дешевеет.
# Значения по умолчанию: 10%, без минимальной суммы, код включён.
PROMO_HARVEST_PERCENT=10
# Минимальная сумма товаров, ₽ (0 или пусто — без порога).
PROMO_HARVEST_MIN=0
# Фиксированная скидка в рублях ВМЕСТО процентов: работает, только если
# PROMO_HARVEST_PERCENT=0.
PROMO_HARVEST_AMOUNT=
# Выключить промокод совсем: PROMO_HARVEST_ENABLED=false
PROMO_HARVEST_ENABLED=

# --- Оплата через Robokassa. Инструкция — SETUP-PAYMENTS-RU.md ---
# Пока логин и оба пароля не заданы — онлайн-оплата ВЫКЛЮЧЕНА, сайт работает
# как есть (заказ без оплаты).
# Публичный адрес сайта — на него Robokassa возвращает покупателя после оплаты.
SITE_URL=https://tomatsemena.ru
# Идентификатор магазина из ЛК Robokassa (НЕ e-mail): например tomatsemena.
ROBOKASSA_LOGIN=
# Пароль #1 — им сайт подписывает счёт; Пароль #2 — им Robokassa подписывает
# уведомление об оплате. Оба берутся в Технических настройках магазина.
ROBOKASSA_PASSWORD1=
ROBOKASSA_PASSWORD2=
# Пароль #3 — ключ Refund API: с ним возврат делается прямо из админки.
# Без него оплата работает полностью, но возврат нужно делать в ЛК Robokassa,
# а в админке отмечать («Отметить возврат»).
ROBOKASSA_PASSWORD3=
# Тестовый режим: 1 — платежи идут с IsTest=1 и подписываются ТЕСТОВЫМИ
# паролями (в технастройках это отдельная пара).
ROBOKASSA_TEST=
ROBOKASSA_TEST_PASSWORD1=
ROBOKASSA_TEST_PASSWORD2=
# Алгоритм расчёта хеша — тот же, что выбран в технастройках магазина:
# md5 (по умолчанию), sha1, sha256, sha384, sha512, ripemd160.
ROBOKASSA_HASH=
# Фискальный чек (54-ФЗ) с номенклатурой: on — сайт собирает чек сам
# (товары + доставка отдельной услугой, скидка разносится по товарам).
# ОБЯЗАТЕЛЬНО при подключённой фискализации (Робочеки, касса): без чека
# Robokassa не пробьёт чек и не покажет часть способов оплаты.
ROBOKASSA_RECEIPT=
# Система налогообложения для чека: usn_income, usn_income_outcome, osn,
# patent, envd. Можно не задавать — тогда берётся значение из ЛК Robokassa.
ROBOKASSA_SNO=
# Ставка НДС в чеке: none (по умолчанию), vat0, vat10, vat20 и т.д.
ROBOKASSA_TAX=
# Признак способа расчёта в чеке. По умолчанию full_prepayment («Предоплата
# 100%») — деньги получены до отгрузки. Должен совпадать с «Методом платежа»
# в настройках Робочеков. Другие значения: prepayment, advance, full_payment.
ROBOKASSA_PAYMENT_METHOD=
# Признак предмета расчёта для товаров: commodity (по умолчанию), service и др.
# Доставка всегда идёт отдельной позицией-услугой (service).
ROBOKASSA_PAYMENT_OBJECT=
# Кодирование чека: both (по умолчанию), sign, field, raw. Подбирать вручную не
# нужно — `npm run check:pay` перебирает все четыре и говорит, какое принимает
# твой магазин.
ROBOKASSA_RECEIPT_ENCODE=
# Срок жизни счёта в минутах (по умолчанию 20 — столько же живёт черновик
# оплаты до уборки). 0 — не ограничивать.
ROBOKASSA_INVOICE_TTL_MIN=

# --- Плановая уборка зависших неоплаченных заказов ---
# Секрет для защиты роута /api/cron/cleanup (его дёргает systemd-таймер, см.
# deploy/cleanup.timer). Пока пусто — роут выключен (404). Сгенерировать:
#   openssl rand -hex 32
# То же значение положите в /etc/default/tomatsemena (CRON_SECRET=...).
#
# Этим же секретом защищён /api/revalidate — сброс кэша карты сайта и каталога.
# Скрипты из scripts/ (db:slugs, db:images, db:strip-prefix) дёргают его сами
# после массовых правок, иначе sitemap.xml обновился бы только через час.
CRON_SECRET=

# --- Заголовки безопасности (CSP) ---
# Content-Security-Policy собирается в next.config.mjs из адресов сервисов,
# которые сайт реально использует (PocketBase, SmartCaptcha, Метрика, Robokassa).
# По умолчанию она ВКЛЮЧЕНА и блокирует нарушения.
#
# Если после подключения нового сервиса что-то перестало грузиться — поставьте
# на время «1»: браузер перестанет блокировать и будет только писать в консоль,
# что заблокировал бы. Посмотрите консоль, добавьте адрес в next.config.mjs и
# верните обратно (пусто).
CSP_REPORT_ONLY=
