# Юнит systemd для PocketBase (база данных магазина).
# Установка — SETUP-DB-RU.md, шаг 2. Кратко:
#   sudo cp deploy/pocketbase.service /etc/systemd/system/pocketbase.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now pocketbase

[Unit]
Description=PocketBase (Tomat Semena DB)
After=network.target

[Service]
Type=simple
User=pocketbase
Group=pocketbase
WorkingDirectory=/opt/pocketbase
# База слушает ТОЛЬКО петлевой интерфейс: наружу её отдаёт nginx по HTTPS
# (location /pb/ в deploy/nginx.conf), а админка /_/ закрыта там же. Порт 8090
# в ufw открывать не нужно — из интернета он недоступен.
#
# Если домен и nginx ещё не настроены и браузер должен ходить в базу напрямую
# по http://IP:8090, временно поставьте --http=0.0.0.0:8090 и откройте порт в
# ufw. Это черновой режим: база торчит в интернет по голому http, пароли и
# токены летят открытым текстом — возвращайте 127.0.0.1 сразу после настройки
# nginx (SETUP-DB-RU.md, шаг 10).
ExecStart=/opt/pocketbase/pocketbase serve --http=127.0.0.1:8090 --dir /opt/pocketbase/pb_data
Restart=on-failure
RestartSec=5
LimitNOFILE=4096
StandardOutput=journal
StandardError=journal

# Песочница: RCE в базе не должно хватать на захват машины.
# ProtectSystem=strict делает ВЕСЬ диск только для чтения, поэтому единственный
# writable путь открываем явно — папку данных (SQLite, WAL, фото товаров).
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/opt/pocketbase/pb_data
# Побочный эффект: сам каталог /opt/pocketbase только для чтения, поэтому
# обновление бинарника (`pocketbase update`) под юнитом не пройдёт — обновляйте
# при остановленной службе. Бэкапы (deploy/pb-backup.sh) это не задевает: их
# делает отдельная задача по расписанию, а не сама служба.

[Install]
WantedBy=multi-user.target
